# =====================================================================
# Panneau /admin — variables d'environnement (voir docs/ADMIN.md)
# Sur Vercel : portée « Production » UNIQUEMENT ; secrets en type « Sensitive ».
# En local : copier vers .env.local (ignoré par Git). Ne JAMAIS committer de valeur réelle.
# Toute variable absente ou mal formée ⇒ l'API répond 503 ADMIN_DISABLED.
# =====================================================================

# --- Interrupteur et identité de l'admin ---
ADMIN_ENABLED=false
# Origine exacte, sans slash final
ADMIN_ORIGIN=https://jokitsune.vercel.app
# ID numérique immuable du compte : gh api users/Jokitsune --jq .id
ADMIN_GITHUB_ID=
ADMIN_GITHUB_LOGIN=Jokitsune

# --- OAuth App « jokitsune-admin-login » (aucun scope) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App « jokitsune-admin-writer » (contents:write, pull_requests:write, checks:read) ---
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM encodé en base64 sur une ligne : base64 -w0 private-key.pem
GITHUB_APP_PRIVATE_KEY_B64=

# --- Dépôt cible ---
GITHUB_REPO_OWNER=Jokitsune
GITHUB_REPO_NAME=JoKitsune.github.io
# ID numérique du dépôt : gh api repos/Jokitsune/JoKitsune.github.io --jq .id
GITHUB_REPO_ID=
CONTENT_BASE_BRANCH=main
CONTENT_DRAFT_BRANCH=content/draft
# pr (recommandé : brouillon + PR) | direct (écriture sur la branche de base)
PUBLISH_MODE=pr
# Alias stable de la preview de la branche brouillon (protégée par Vercel Authentication)
DRAFT_PREVIEW_URL=

# --- Session ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Incrémenter (puis redéployer) pour révoquer toutes les sessions
SESSION_VERSION=1
SESSION_TTL_SECONDS=14400
STEP_UP_MAX_AGE_SECONDS=900

# info | warn | error
LOG_LEVEL=info

# --- Développement local UNIQUEMENT (refusé si VERCEL_ENV=production ou preview) ---
# Backend fichier local, sans GitHub : npm run dev:admin
# ADMIN_DEV_MODE=1
# ADMIN_DEV_DATA_DIR=.admin-dev
