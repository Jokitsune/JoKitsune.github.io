{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "visible": {
            "type": "boolean"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^[^<>]*$"
              },
              {
                "type": "object",
                "properties": {
                  "fr": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>]*$"
                  },
                  "en": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>]*$"
                  }
                },
                "required": [
                  "fr",
                  "en"
                ],
                "additionalProperties": false
              }
            ]
          },
          "org": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^[^<>]*$"
              },
              {
                "type": "object",
                "properties": {
                  "fr": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>]*$"
                  },
                  "en": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>]*$"
                  }
                },
                "required": [
                  "fr",
                  "en"
                ],
                "additionalProperties": false
              }
            ]
          },
          "logo": {
            "type": "string",
            "pattern": "^\\/images\\/uploads\\/[a-z0-9-]+\\.(png|jpg|webp|svg)$"
          },
          "logoAlt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^[^<>]*$"
              },
              {
                "type": "object",
                "properties": {
                  "fr": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>]*$"
                  },
                  "en": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>]*$"
                  }
                },
                "required": [
                  "fr",
                  "en"
                ],
                "additionalProperties": false
              }
            ]
          },
          "verifyUrl": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https:\\/\\/[A-Za-z0-9.-]+(?::\\d{1,5})?(?:[/?#][^\\s<>\"'`\\\\]*)?$"
          },
          "verifyPlatform": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^<>]*$"
          }
        },
        "required": [
          "id",
          "order",
          "visible",
          "title",
          "org"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cards"
  ],
  "additionalProperties": false
}
