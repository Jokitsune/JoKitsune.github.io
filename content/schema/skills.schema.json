{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "visible": {
            "type": "boolean"
          },
          "icon": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^<>]*$"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^[^<>]*$"
              },
              {
                "type": "object",
                "properties": {
                  "fr": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>]*$"
                  },
                  "en": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^<>]*$"
                  }
                },
                "required": [
                  "fr",
                  "en"
                ],
                "additionalProperties": false
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000,
                  "pattern": "^[^<>]*$"
                },
                {
                  "type": "object",
                  "properties": {
                    "fr": {
                      "type": "string",
                      "maxLength": 2000,
                      "pattern": "^[^<>]*$"
                    },
                    "en": {
                      "type": "string",
                      "maxLength": 2000,
                      "pattern": "^[^<>]*$"
                    }
                  },
                  "required": [
                    "fr",
                    "en"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "order",
          "visible",
          "icon",
          "title",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "categories"
  ],
  "additionalProperties": false
}
